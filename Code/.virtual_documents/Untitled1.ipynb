my_keys = ['A', 'B', 'C']

my_values = [[21, 34], (1, 2, 4.5, 5, 6), ['Art', 'Bart', 'Fart']]



def create_dict(keys, vals):
    """
    Function to create a dictionary from two arrays
    
    keys: array containing the keys (immutable)
    vals: ...
    """

    new_dict = dict()

    for index, key in enumerate(keys):

        new_dict[key] = vals[index]

    return new_dict



help(create_dict)


my_new_dict = create_dict(my_keys, my_values)

my_new_dict





